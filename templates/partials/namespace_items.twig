{#
 # One level of the namespace view. Rendered in the page for the top level and over ajax (?namespaces=prefix) for the levels below.
 #}
{% set show_actions = not readonly %}

{% macro size_bar(percentage) %}
    <div class="hidden md:flex items-center gap-2 w-28 shrink-0">
        <div class="flex-1 h-2 bg-gray-200 rounded-sm dark:bg-gray-700 overflow-hidden">
            <div class="h-full bg-primary-500 rounded-sm" style="width: {{ percentage }}%"></div>
        </div>
        <span class="w-12 text-xs text-right text-gray-600 dark:text-gray-300">{{ percentage|number(1) }}%</span>
    </div>
{% endmacro %}

{% macro paginator(pagination) %}
    {% if pagination.total_pages > 1 %}
        {% set page = pagination.page %}
        {% set last = pagination.total_pages %}
        {% set button = 'ns-page py-1 px-2 text-xs rounded-sm disabled:opacity-50 disabled:cursor-not-allowed' %}
        {% set idle = ' bg-white dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600' %}
        {% set active = ' bg-primary-500 text-white' %}
        <div class="flex flex-wrap gap-2 justify-between items-center py-2 px-6 border-t border-gray-200 dark:border-gray-700 bg-gray-100 dark:bg-gray-800">
            <span class="text-xs text-gray-600 dark:text-gray-300">
                Showing {{ ((page - 1) * pagination.per_page + 1)|number }} - {{ min(page * pagination.per_page, pagination.total)|number }} of {{ pagination.total|number }} namespaces
            </span>
            <div class="flex gap-1 items-center">
                <button type="button" class="{{ button ~ idle }}" data-page="{{ page - 1 }}"{{ page <= 1 ? ' disabled' : '' }} aria-label="Previous page">&laquo;</button>
                {% for p in range(1, last) %}
                    {% if p == 1 or p == last or (p >= page - 2 and p <= page + 2) %}
                        <button type="button" class="{{ button ~ (p == page ? active : idle) }}" data-page="{{ p }}">{{ p }}</button>
                    {% elseif p == page - 3 or p == page + 3 %}
                        <span class="px-1 text-gray-400">...</span>
                    {% endif %}
                {% endfor %}
                <button type="button" class="{{ button ~ idle }}" data-page="{{ page + 1 }}"{{ page >= last ? ' disabled' : '' }} aria-label="Next page">&raquo;</button>
            </div>
        </div>
    {% endif %}
{% endmacro %}

{% if direct_keys_count > 0 %}
    <div class="flex gap-2 items-center py-2 px-6 border-t border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50 text-sm">
        <span class="flex-1 min-w-0 text-gray-600 dark:text-gray-300"{{ direct_keys_names is not empty ? ' title="%s"'|format(direct_keys_names|join(', ')|e('html_attr'))|raw : '' }}>
            <span class="font-medium">{{ direct_keys_count|number }}</span> direct key{{ direct_keys_count > 1 ? 's' : '' }}{{ prefix is empty ? ' (not in any namespace)' : '' }}
        </span>
        <span class="w-20 md:w-24 shrink-0 text-right" title="Total size">{{ direct_keys_size|bytes }}</span>
        {{ _self.size_bar(direct_keys_percentage) }}
        {% if show_actions %}
            <span class="w-10 md:w-36 shrink-0"></span>
        {% endif %}
    </div>
{% endif %}

{{ _self.paginator(pagination) }}

{% for ns in namespaces %}
    <div class="namespace-item border-t border-gray-200 dark:border-gray-700" data-namespace="{{ ns.path }}" data-has-children="{{ ns.has_children ? 1 : 0 }}">
        <div class="flex gap-2 items-center py-2 px-6 text-sm hover:bg-gray-50 dark:hover:bg-white/5">
            <button type="button" class="flex shrink-0 items-center namespace-toggle{{ ns.has_children ? '' : ' invisible' }}" aria-label="Expand">
                {{ svg('down', 10, '-rotate-90 transition-transform') }}
            </button>
            <span class="flex-1 min-w-0 font-semibold truncate text-primary-500 dark:text-primary-400"{{ ns.direct_keys_names is not empty ? ' title="%s"'|format(ns.direct_keys_names|join(', ')|e('html_attr'))|raw : '' }}>
                {{- ns.name }}{{ separator }}*
            </span>
            <span class="hidden md:inline w-24 shrink-0 text-right" title="Keys count">{{ ns.count|number }} key{{ ns.count > 1 ? 's' : '' }}</span>
            <span class="w-20 md:w-24 shrink-0 text-right" title="Total size">{{ ns.size|bytes }}</span>
            {{ _self.size_bar(ns.percentage) }}
            <a href="{{ link([], {view: 'table', s: ns.path ~ separator ~ '*'}) }}" title="Filter keys in this namespace"
               class="inline-flex shrink-0 gap-1 items-center font-semibold text-primary-500 hover:text-primary-700">
                {{ svg('search', 16) }} <span class="hidden md:inline">Filter</span>
            </a>
            {% if show_actions %}
                <button type="button" class="inline-flex shrink-0 gap-1 items-center font-semibold text-red-500 hover:text-red-700 delete-namespace" title="Delete all keys in this namespace">
                    {{ svg('trash', 16) }} <span class="hidden md:inline">Delete</span>
                </button>
            {% endif %}
        </div>
        <div class="hidden pl-6 namespace-children">
            <div class="namespace-children-content" data-namespace="{{ ns.path }}"></div>
        </div>
    </div>
{% endfor %}

{% if prefix is not empty and namespaces is empty and direct_keys_count == 0 %}
    <div class="py-4 px-6 text-center border-t border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300">No namespaces.</div>
{% endif %}

{{ _self.paginator(pagination) }}
